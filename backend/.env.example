# =============================================================================
# Zain Data Pool Monitor - environment configuration
# =============================================================================

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
PORT=5005
NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Oracle (CBS source of truth for CDR usage)
# -----------------------------------------------------------------------------
ORACLE_USER=your_cbs_user
ORACLE_PASSWORD=your_cbs_password
ORACLE_HOST=10.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE=YOUR_SERVICE
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4
# Only set this if you must use Oracle Client (thick mode). Leave empty for thin mode.
ORACLE_CLIENT_DIR=
# Upper bound on one CBS query. A slow database would otherwise stall the poll
# cycle indefinitely. 0 disables the limit.
ORACLE_QUERY_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# MySQL (local store of SMS already sent, so each MSISDN gets 50% and 100% once a month)
# -----------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=
MYSQL_DATABASE=automations
MYSQL_PORT=3306

# Pins the session time zone so NOW() and CURRENT_TIMESTAMP match this process.
# Empty means "use this process's own offset", which keeps event times and
# created_at consistent inside a row without the database having to be
# configured correctly - a server left on UTC while the app runs Africa/Juba
# otherwise writes them two hours apart. Prefer an offset like "+02:00" over a
# name like "Africa/Juba": the named form needs the server's time zone tables
# loaded and many installs never load them.
MYSQL_TIME_ZONE=

# Tables. All five are created automatically on server start if missing.
MYSQL_TABLE_NOTIFICATIONS=automation_notifications
MYSQL_TABLE_STATUS=automation_status
MYSQL_TABLE_USAGE=automation_usage
# The offers the monitor watches - one row per wallet, managed over the API.
MYSQL_TABLE_OFFERS=offers_info
MYSQL_TABLE_ADMINS=admins

# How often the status row is rewritten (the poller itself runs every second).
STATUS_PERSIST_MS=15000

# -----------------------------------------------------------------------------
# Monitored offers
# -----------------------------------------------------------------------------
# What is monitored lives in the offers table (MYSQL_TABLE_OFFERS), one row per
# wallet, pushed in over the API:
#
#   POST /api/offers
#   { "WALLET_ID": "10271", "OFFER_NAME": "10GB Postpaid Pool",
#     "POOL_CAP_GB": 10, "THRESHOLD_50_GB": 5, "THRESHOLD_100_GB": 10 }
#
# The three values below are used ONCE, to seed that table on a fresh install
# when it is empty. After that the table is the only source of truth and these
# are ignored - editing them changes nothing.
#
# ACCOUNT_CODE is no longer used to select CDRs at all. A pooled offer is
# identified by its wallet, and one wallet's subscribers routinely sit under many
# different account codes, so filtering by account would silently monitor a
# fraction of them.
ACCOUNT_CODE=
WALLET_ID=00000
OFFER_NAME=Example 10GB Pool

# Whether that seeded row starts active. Off by default: a fresh host's
# WALLET_ID is rarely the wallet anyone intended to monitor - on one deployment
# it was a leftover with no traffic, which logged "will never alert" on every
# boot. Had it been a busy wallet instead, a brand-new install would have
# started SMSing its subscribers before anyone reviewed the settings. Confirm
# with GET /api/offers/<wallet>/cdrs, then activate deliberately.
OFFER_SEED_ACTIVE=false

# Usage accumulation window. MONTH = the monthly cycle below (matches the
# "twice per month" alert rule). DAY = today only. CUSTOM uses CUSTOM_FROM/TO.
USAGE_WINDOW=MONTH

# When the monthly counter resets to zero, and with it every subscriber's
# eligibility for a fresh 50% / 100% alert.
#   LAST_DAY  = 00:00 (12:00 AM) on the last day of the month - 31 Jul, 31 Aug, 28 Feb...
#   FIRST_DAY = 00:00 on the 1st of the month
MONTH_RESET=FIRST_DAY
CUSTOM_FROM=
CUSTOM_TO=

# -----------------------------------------------------------------------------
# Thresholds (1 GB = 1024 MB = 1024^3 bytes, matching the SQL /1024/1024/1024)
# An MB variable overrides its GB counterpart when set.
#
# Seed values only, like WALLET_ID above. Each offer carries its own cap and its
# own two bars in the offers table; these three only populate the first row on a
# fresh install. Everything below this block still applies to every offer.
# -----------------------------------------------------------------------------
POOL_CAP_GB=10
THRESHOLD_50_GB=5
THRESHOLD_100_GB=10

# How usage is compared to a threshold.
#   EXACT   = raw bytes; never alerts before the data is genuinely used, but the
#             report can read "1 GB" while the counter is a few hundred bytes short.
#   ROUNDED = compares the same rounded GB the report shows, so an alert never
#             disagrees with what operators see. Fires up to 0.05 GB early.
THRESHOLD_MATCH=ROUNDED
THRESHOLD_MATCH_DECIMALS=1

# What to do when a subscriber clears more than one bar between polls.
#   SEPARATE = send the lowest outstanding now, the next on a later cycle, so
#              each threshold is its own event rather than two SMS at once.
#   ALL      = send every outstanding threshold immediately, in order.
#   HIGHEST  = send only the highest; the ones jumped over are skipped.
THRESHOLD_FIRE=SEPARATE

# If a subscriber blows past 5 GB and 10 GB between two polls, send both SMS.
SEND_MISSED_THRESHOLDS=true

# Starting mid-month, subscribers may already be deep into their cap.
# true  = bars passed before the monitor first saw them are recorded as
#         SKIPPED, not sent. Only the most recent cap crossing still fires,
#         so someone already at 19 GB of 20 gets the 100% and never a stale 50%.
# false = every passed bar is announced on first sight, oldest first.
SKIP_PASSED_ON_FIRST_SIGHT=true

# -----------------------------------------------------------------------------
# Poller
# -----------------------------------------------------------------------------
# The CBS query takes 70-1800 ms, and a cycle never overlaps the previous one,
# so the real rate is bounded by query time. 1000 keeps CBS load reasonable while
# still catching a threshold crossing within a second of it appearing in the CDRs.
POLL_INTERVAL_MS=1000
MONITOR_AUTOSTART=true
# Never sends real SMS while true - it only logs and writes to MySQL.
# LIVE: real SMS are being delivered through the Floodwave gateway.
DRY_RUN=true

# -----------------------------------------------------------------------------
# Floodwave SMS gateway
# -----------------------------------------------------------------------------
FLOODWAVE_NOTIFY_URL=https://zain-floodwave.com/api/v1/notify/notification
FLOODWAVE_CLIENT_ID=00
FLOODWAVE_NOTIFY_SERVICE_TYPE=notification
FLOODWAVE_SENDER_ID=ZAINDATA
FLOODWAVE_TIMEOUT_MS=15000
# HTTP retries inside a single delivery attempt.
FLOODWAVE_MAX_ATTEMPTS=3
# How many polling cycles may retry an alert that keeps failing, before giving up for the month.
SMS_MAX_RETRY_CYCLES=5
# Authentication: the API key is sent in the FLOODWAVE_AUTH_HEADER header.
FLOODWAVE_API_KEY=your_floodwave_api_key
FLOODWAVE_AUTH_HEADER=X-API-KEY

# Further headers the gateway requires. The client and service identifiers travel
# here rather than in the request body.
FLOODWAVE_HEADERS=X-Client-ID: 00, X-Service-Type: notification

# Prefix SERVICE_IDENTIFIER_V with a country code before sending (e.g. 249).
# Leave empty to send the MSISDN exactly as it appears in the CDR.
# The gateway requires a unique reference per message; this prefixes the
# generated value so our alerts are identifiable in Floodwave logs.
SMS_REFERENCE_PREFIX=ZBSS
SMS_PRIORITY=1

SMS_COUNTRY_CODE=

# -----------------------------------------------------------------------------
# Message templates
# -----------------------------------------------------------------------------
# Shared by every offer. {offer} is replaced with that offer's OFFER_NAME from
# the offers table, so adding an offer never means writing message text - and one
# reword here applies to all of them at once.
#
# Deliberately not stored per offer: a message that names a cap ("your 20 gb
# cap") drifts out of step the moment POOL_CAP_GB changes, which had already
# happened here - the old text said 20 gb while the cap was 10.
#
# GET /api/offers returns the exact rendered text as messagePreview.
#
# These must fit SMS_MAX_LENGTH once {offer} is substituted. The gateway rejects
# anything longer with a 400 and {"message":"Message exceeds 160 characters"} -
# a permanent failure, so an over-long template loses every alert it touches
# instead of degrading. Fuller wordings were tried and do not fit:
#   "...to subscribe to our valid offers and internet services. Thank you for
#    choosing Zain's service."   -> 190-212 characters, undeliverable
# They only become usable if the gateway enables multipart SMS.
SMS_TEMPLATE_50="Dear Valued Customer, you have used 50% of your {offer} data bundle. Recharge and dial *190# to subscribe for more bundle. Thank you."
SMS_TEMPLATE_100="Dear Valued Customer, you have used 100% of your {offer} data bundle. Recharge and dial *190# to subscribe for more bundle. Thank you."

# Hard limit the gateway enforces. Checked when an offer is saved and again
# before each send, so an over-long message never reaches the gateway.
SMS_MAX_LENGTH=160

# Words removed from a bundle name before it reaches the customer - currency
# codes and internal jargon that mean nothing to them. Comma separated,
# whole-word and case-insensitive, so removing USD leaves USDA alone and
# removing Quota leaves Quotable alone. Add or drop words here rather than
# changing code; an empty list leaves names untouched.
#   "Daily_Quota_1GB"          -> "Daily 1GB"
#   "Postpaid_Hybrid-15GB_SSP" -> "Postpaid Hybrid 15GB"
#   "Gold_USD_10GB"            -> "Gold 10GB"
SMS_OFFER_NAME_STRIP=SSP,USD,Quota

# -----------------------------------------------------------------------------
# API authentication
# -----------------------------------------------------------------------------
# Every route except /api/health and /api/auth/login needs a credential, as
# either "Authorization: Bearer <token>" from POST /api/auth/login, or HTTP Basic.
AUTH_ENABLED=true

# Signs bearer tokens. Left empty, a key is generated at startup and every token
# is invalidated by a restart. Set it to any long random string.
AUTH_SECRET=
AUTH_TOKEN_TTL_MINUTES=720

# Written to the admins table only when that table is empty, so rotating the
# password through POST /api/admins/password is never undone by a restart.
# Change the password immediately - this file is committed as a template.
ADMIN_DEFAULT_USERNAME=zainadmin
ADMIN_DEFAULT_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Bundle activation notices (EDR feed)
# -----------------------------------------------------------------------------
# A second, independent poller. It watches CB_PREPAID_UPLOAD_ALL_EDRS joined to
# CB_OFFERS and SMSes the subscriber when a bundle is activated. One notice per
# EDR, keyed on CHRONO_NUM_V, so re-subscribing to the same bundle is announced
# again while a single event is never sent twice.
ACTIVATION_ENABLED=true

# The send switch, separate from ACTIVATION_ENABLED above.
#   ACTIVATION_ENABLED=false     the poller does not run; nothing is recorded.
#   ACTIVATION_SMS_ENABLED=false the poller runs and records every activation,
#                                it just sends no SMS.
# Use false to watch what the feed produces before letting it message anyone,
# or to hold sending during an incident without losing the record.
# Activations recorded while this is false are closed as SKIPPED, not queued:
# turning it back on sends what happens next, never a backlog of notices telling
# people their bundle was activated hours ago.
ACTIVATION_SMS_ENABLED=true
ACTIVATION_POLL_INTERVAL_MS=1000

# Only offers whose CB_OFFERS.SUB_SERVICE_CODE_V matches are announced. The
# column is on the offer, not the EDR. Required: empty would drop the predicate
# and announce every subscription on the platform.
ACTIVATION_SUB_SERVICE_CODE=HYBRID

# {offer} is CB_OFFERS.DETAIL_DESCRIPTION_V with _ and - turned into spaces and
# the SSP / USD currency suffixes removed, so "Postpaid_Hybrid-15GB_SSP" reaches
# the customer as "Postpaid Hybrid 15GB". Must fit SMS_MAX_LENGTH once rendered.
SMS_TEMPLATE_ACTIVATION="Dear Valued Customer, your data bundle of {offer} has been successfully activated. Thank you for using Zain service."

# The first run of a day sees every activation since midnight as new. Announcing
# them would tell someone at 18:00 that their 07:00 bundle has just been
# activated, for every subscriber at once. false records that backlog as SKIPPED.
# How far back an activation may be and still be announced.
#   MIDNIGHT - everything from 00:00 today. The day is the unit of work, so an
#              activation at 00:05 is announced whether the service started at
#              23:00 yesterday or 00:04 today.
#   START    - only activations at or after this process began watching. Use
#              when a long outage must not produce a burst of late notices.
# Either way the CHRONO_NUM_V key means an activation already recorded is never
# announced twice, so a restart replays nothing.
ACTIVATION_WATCH_FROM=MIDNIGHT

# -----------------------------------------------------------------------------
# Tuning - every one of these has a working default; set them only to change it
# -----------------------------------------------------------------------------
# MySQL connection pool size.
MYSQL_POOL_LIMIT=5
# Bundle-activation notices live here.
MYSQL_TABLE_ACTIVATIONS=activation_notifications

# How often the usage mirror is rewritten even when nothing moved, so updated_at
# proves the figures are live rather than the monitor being dead.
USAGE_PERSIST_MS=1000

# Delivery queue. Concurrency bounds how hard the gateway is hit during a burst;
# the poller never blocks on it either way.
SMS_QUEUE_CONCURRENCY=2
SMS_QUEUE_MAX=5000

# Minimum wait before a failed alert is retried. Without it the one-second poll
# would spend the whole retry budget within seconds of a brief gateway blip and
# lose the alert for the month. Measured by MySQL against its own clock, so a
# database on a different timezone from this process cannot skew it.
SMS_RETRY_COOLDOWN_MS=300000

# A 5xx or timeout is the gateway being unwell and can last hours, so it gets a
# far larger budget than SMS_MAX_RETRY_CYCLES, which covers 4xx - those would
# fail identically every time.
SMS_MAX_RETRY_CYCLES_TRANSIENT=200

# Optional spacing between two messages to the SAME subscriber. Off by default:
# an alert should go out when its threshold is reached, not be held back.
SMS_MIN_GAP_MS=0

# Windows only: when the HTTP port is held by this service's own scheduled task,
# stop it and take the port. false makes a port clash a plain failure instead -
# worth setting when a second copy running unnoticed would be worse than a
# refusal to start.
TAKEOVER_PORT=true
